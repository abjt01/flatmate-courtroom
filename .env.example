# Free key from https://console.groq.com/keys
# Leave it empty to run the court in mock mode (canned rulings, no API calls).
GROQ_API_KEY=

# Bench of judges (comma separated) and the chief justice who writes the final judgment
# BENCH_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# CHIEF_MODEL=openai/gpt-oss-120b

# Run fully offline with Ollama instead of Groq
# LLM_BASE_URL=http://localhost:11434/v1
# BENCH_MODELS=gemma3:4b
# CHIEF_MODEL=gemma3:4b

# Keep cases across restarts (free MongoDB Atlas M0 cluster). Without it cases go to a JSON file.
# MONGODB_URI=
# DATA_DIR=./data

PORT=4000
